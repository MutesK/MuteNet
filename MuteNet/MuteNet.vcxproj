  <!-- vcpkg 및 매니페스트 존재 여부 사전 검증 -->
  <Target Name="CheckVcpkgInstalled" BeforeTargets="PrepareForBuild">
    <!-- 1. vcpkg.json 파일이 없는 경우 -->
    <Error Condition="!Exists('$(ProjectDir)vcpkg.json')" Text="[MuteNet Build Error] 'vcpkg.json' 파일이 프로젝트 경로에 없습니다. Breakpad 패키지 설정을 위해 vcpkg.json을 생성해주세요." />
    <!-- 2. vcpkg 통합 설정(Root)이나 vcpkg.exe를 찾을 수 없는 경우 -->
    <Error Condition="'$(VcpkgRoot)' == '' AND !Exists('C:\vcpkg\vcpkg.exe')" Text="[MuteNet Build Error] vcpkg가 설치되어 있지 않거나 통합되지 않았습니다! 'vcpkg integrate install'을 실행하거나 C:\vcpkg 에 vcpkg를 설치해주세요." />
  </Target>
